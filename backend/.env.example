# Local development defaults
APP_NAME=VideoMind AI
ENVIRONMENT=development
SECRET_KEY=replace-this-with-a-long-random-secret
DATABASE_URL=sqlite:///./videomind.db
UPLOADS_DIR=../storage/uploads
MAX_UPLOAD_MB=500

# Faster-Whisper downloads this model on first transcription.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# 384-dimensional multilingual SentenceTransformer model; downloads on first indexing.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

# Configure ONE LLM option:
# Hosted OpenAI-compatible API:
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# For local Ollama OpenAI-compatible API instead, use:
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
