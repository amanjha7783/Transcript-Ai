# Optional LLM settings for Docker Compose
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
WHISPER_MODEL=base
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# AI Slide Extractor
SLIDES_ENABLED=true
SLIDE_SAMPLE_FPS=1.0
SLIDE_OUTPUT_WIDTH=1280
SLIDE_MIN_INTERVAL_SECONDS=1.5
SLIDE_MAX_VIDEO_SIZE_MB=500

